/* ==========================================
   MY LOVE STORY SECTION - FULL CSS STYLING
   ========================================== */

/* 1. மெயின் "My Love Story" கண்டெய்னர் (பேக்ரவுண்ட் இமேஜ் மற்றும் ஷேடோவுடன்) */
.my-love-story {
    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('watermarked_img_11493212795287328625.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 50px 20px;
    border-radius: 20px;
    text-align: center;
    color: #ffffff;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    margin: 30px 0;
}

/* 2. கவிதை பகுதி (Poem Box Style - கவிதையுடன் சேர்த்து CSS-லேயே அமைப்பு) */
.my-love-story .love-poem-box {
    margin-bottom: 30px;
    padding: 25px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 15px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.my-love-story .love-poem-box::before {
    content: "விழியோட பார்வையில் தொடங்கி...\A இதயத்தின் துடிப்பில் கலந்த உன் நினைவுகள்,\A என் வாழ்வின் அழகான காவியமாய்...\A காலம் கடந்தும் தொடர்கிறது நம் காதல்!";
    white-space: pre-wrap;
    font-size: 20px;
    font-weight: 600;
    font-family: 'Georgia', serif;
    line-height: 1.6;
    color: #ffccd5;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    display: block;
}

/* 3. 6 போட்டோக்களை வைக்க grid அமைப்பு (3 columns, 2 rows) */
.my-love-story .photo-grid-box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    max-width: 800px;
    margin: 0 auto 30px auto;
}

.my-love-story .photo-placeholder {
    background: rgba(255, 255, 255, 0.15);
    border: 2px dashed rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.3s ease, background 0.3s ease;
    backdrop-filter: blur(5px);
}

.my-love-story .photo-placeholder:hover {
    transform: scale(1.05);
    background: rgba(255, 255, 255, 0.25);
}

.my-love-story .photo-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
}

/* 4. போட்டோ அப்லோட் செக்ஷன் ஸ்டைல் */
.my-love-story .upload-section {
    margin-top: 35px;
    padding: 20px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 15px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
}

.my-love-story .upload-section h3 {
    color: #ffccd5;
    font-size: 18px;
    margin-bottom: 15px;
    font-weight: 600;
}

.my-love-story .upload-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.my-love-story .upload-form input[type="file"] {
    display: none;
}

.my-love-story .upload-btn {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 10px 20px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 15px;
    border: 1px dashed rgba(255, 255, 255, 0.6);
    transition: background 0.3s ease;
}

.my-love-story .upload-btn:hover {
    background: rgba(255, 255, 255, 0.35);
}

.my-love-story .submit-btn {
    background: linear-gradient(135deg, #ff758c, #ff7eb3);
    color: white;
    border: none;
    padding: 10px 25px;
    border-radius: 25px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(255, 117, 140, 0.4);
    transition: transform 0.3s ease;
}

.my-love-story .submit-btn:hover {
    transform: translateY(-2px);
}

/* 5. மொபைல் ஸ்கிரீனுக்கான ரெஸ்பான்சிவ் அமைப்பு */
@media (max-width: 768px) {
    .my-love-story .photo-grid-box {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .my-love-story .love-poem-box::before {
        font-size: 16px;
    }
}
